# Web3Forms — powers the Contact section's lead-capture form (POST to Web3Forms).
# Both values are injected at BUILD time (Vite `import.meta.env`). Ship this file
# with variable NAMES only — never commit the real access key.

# VITE_WEB3FORMS_ENDPOINT: The Web3Forms submission endpoint the form POSTs to.
VITE_WEB3FORMS_ENDPOINT=

# VITE_WEB3FORMS_KEY: The Web3Forms access key that authorizes the submission.
VITE_WEB3FORMS_KEY=
