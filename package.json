{
  "name": "app-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Rebuilt React SPA for Logia Initiative with clean styling and Cloud Run deployment (CRA, no Vite)",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node -e \"if(process.env.SKIP_SNAP==='true'){console.log('Skipping react-snap in CI');process.exit(0)}\" && react-snap",
    "test": "react-scripts test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react-scripts": "5.0.1",
    "react-snap": "^1.23.0",
    "typescript": "^4.9.5"
  },
  "reactSnap": {
    "crawl": false,
    "include": ["/", "/schedule"],
    "skipThirdPartyRequests": true,
    "puppeteerArgs": ["--no-sandbox"]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
